#!/usr/bin/env bash
# devh — финальный dev harness. Один файл. Зависимости: git, bash 4+, агент (goose), flock (желательно).
#
# Модель: харнесс владеет git и циклом; агент (goose headless) делает только
# работу в изолированном worktree и никогда не запускает git.
#
# Надёжность состояния (вместо БД):
#   * все записи статусов атомарны (tmp + mv в той же ФС)
#   * claim-секции под flock (.harness/.lock) — next_id/WIP/статусы без гонок
#   * per-item run.lock (flock -n): параллельный run/merge/abort того же item невозможен;
#     лок держит открытый fd — ядро отпускает его при смерти процесса, stale-локов не бывает
#   * логи: retention LOG_DAYS в `clean`
#
# Гейты — ОБЯЗАТЕЛЬНЫ (проза report.md переведена в код):
#   VERIFY     — тесты/сборка обязаны проходить до коммита
#   NO-IGNORED — allowlist-семантика: игнор разрешён только для имён из
#                IGNORED_ALLOWLIST (файл regex); незаявленный ignored = красный
#   MUTATE     — мутационный гейт на изменённых файлах: kill-rate >= MIN_KILL%;
#                инструмент не установлен = блокер СРЕДЫ, а не «пропуск»
#   CRAP       — guardrail №2 (Uncle Bob): score = C²·(1−cov)³ + C, нарушение = score > CRAP_MAX;
#                инструмент без контракта 'CRAP: functions=N' = блокер СРЕДЫ;
#                обход только записанный: devh new --no-crap "<причина>"
#   red.cmd    — RED-пруф, В ПЕРВУЮ ОЧЕРЕДЬ: до работы обязан падать, после — проходить;
#                обход только записанный: devh new --no-red "<причина>"
# Опционален ТОЛЬКО BENCH — перф-гейт (напр. criterion против baseline)
#
# Команды:
#   devh init / new "title" [--no-red "причина"] [--no-crap "причина"] | new <N> (из todo/N.md) / list / hint [id]
#   devh run [id] / commit [id] (правка summary) / merge [id]
#   devh abort [id] / clean / doctor
#   devh logs [id]             логи item: пути ко всем логам + хвосты agent/verify
#   devh bg [id] / ps          detached-прогон (setsid+nohup) / кто в полёте: PID+стадия
#   devh tickets [--import]    наблюдения агентов (OnFlyAnalysis) → items с red-идеей
#   devh auto [--from <dir>] [--max N]   автопилот: импорт спек → run+merge всех,
#                              спеки без строки "RED: <команда>" остаются в очереди
#   devh selfcov               покрытие test.sh'ом самого devh (kcov)
#
# State: .harness/ у ЦЕЛЕВОГО репо (в git не попадает — локальный exclude). Без БД.
# Дом харнесса: project_uwa/devharness; сам скрипт location-independent (ROOT по cwd).

# shellcheck shell=bash
# shellcheck disable=SC2015  # A && echo ok || echo warn — идиома doctor/fallback-лестниц; echo не падает

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "devh: не git-репозиторий" >&2; exit 1; }
HDIR="$ROOT/.harness"
CONF="$HDIR/config"

# ─── config: дефолты → config-файл → env-override ─────────────────
VERIFY="${HARNESS_VERIFY:-}"
BOOTSTRAP="${HARNESS_BOOTSTRAP:-}"
AGENT="${HARNESS_AGENT:-goose run --no-session -t}"
MAX_FIX="${HARNESS_MAX_FIX:-3}"
REMOTE="${HARNESS_REMOTE:-origin}"
MAIN="${HARNESS_MAIN:-main}"
WT_ROOT="${HARNESS_WT_ROOT:-/tmp}"
MAX_ACTIVE="${HARNESS_MAX_ACTIVE:-3}"
MIN_KILL="${HARNESS_MIN_KILL:-90}"
RED_MUTATE="${HARNESS_RED_MUTATE:-}"
RED_MIN_KILL="${HARNESS_RED_MIN_KILL:-90}"
MUTATE="${HARNESS_MUTATE:-}"
MUTATE_SCOPE="${HARNESS_MUTATE_SCOPE:-}"
CRAP="${HARNESS_CRAP:-}"
CRAP_SCOPE="${HARNESS_CRAP_SCOPE:-}"
CRAP_MAX="${HARNESS_CRAP_MAX:-12}"
BENCH="${HARNESS_BENCH:-}"
AGENT_TIMEOUT="${HARNESS_AGENT_TIMEOUT:-1800}"
LOG_DAYS="${HARNESS_LOG_DAYS:-30}"
RULES="${HARNESS_RULES:-}"
RULES_LOG="${HARNESS_RULES_LOG:-}"
MSG_DENY="${HARNESS_MSG_DENY:-}"
NO_IGNORED="${HARNESS_NO_IGNORED:-1}"
IGNORED_ALLOWLIST="${HARNESS_IGNORED_ALLOWLIST:-scripts/ignored-tests.txt}"
LINT="${HARNESS_LINT:-1}"
LINT_CMD="${HARNESS_LINT_CMD:-}"
REVIEW="${HARNESS_REVIEW:-1}"

need_conf() {
  [ -f "$CONF" ] || { echo "devh: нет $CONF — сначала: devh init" >&2; exit 1; }
  # shellcheck disable=SC1090
  . "$CONF"
  local v env
  for v in VERIFY BOOTSTRAP AGENT MAX_FIX REMOTE MAIN WT_ROOT MAX_ACTIVE MIN_KILL RED_MUTATE RED_MIN_KILL MUTATE MUTATE_SCOPE CRAP CRAP_SCOPE CRAP_MAX BENCH AGENT_TIMEOUT LOG_DAYS RULES RULES_LOG MSG_DENY NO_IGNORED IGNORED_ALLOWLIST LINT LINT_CMD REVIEW; do
    env="HARNESS_$v"
    # shellcheck disable=SC2086
    if [ -n "${!env:-}" ]; then printf -v "$v" '%s' "${!env}"; fi
  done
}

# ─── цвета (cargo-стиль): auto по tty; HARNESS_COLOR=always|never; NO_COLOR ──
case "${HARNESS_COLOR:-auto}" in
  always) FORCE_C=1 ;;
  never)  FORCE_C=0 ;;
  *)      FORCE_C="" ;;
esac
if [ "${FORCE_C:-0}" = 1 ] || { [ -z "$FORCE_C" ] && [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; }; then
  C_G=$'\033[32m'; C_R=$'\033[31m'; C_Y=$'\033[33m'; C_C=$'\033[36m'; C_B=$'\033[1m'; C_D=$'\033[2m'; C_0=$'\033[0m'
else
  C_G=''; C_R=''; C_Y=''; C_C=''; C_B=''; C_D=''; C_0=''
fi

has_flock() { command -v flock >/dev/null 2>&1; }
has_remote() { git -C "$ROOT" remote | grep -q . ; }

# глобальная крит-секция (claim): next_id, WIP-лимит, статусы
NO_FLOCK_WARNED=0
crit_begin() {
  if has_flock; then exec 9>"$HDIR/.lock"; flock -x 9
  elif [ "$NO_FLOCK_WARNED" = 0 ]; then
    echo "devh ⚠: нет flock — состояние без блокировок (гонки при параллельных вызовах)" >&2; NO_FLOCK_WARNED=1
  fi
}
crit_end() { if has_flock; then flock -u 9; fi; }

# per-item лок «в работе»: flock -n; держится до конца процесса
item_runlock() { # $1=id, $2=действие
  if has_flock; then
    exec 8>"$(items_dir)/$1/run.lock"
    flock -n 8 || { echo "devh: $1 сейчас в работе (run.lock занят) — $2 отклонён" >&2; exit 1; }
  fi
}

# ─── items ─────────────────────────────────────────────────────────
items_dir() { echo "$HDIR/items"; }

next_id() {
  local n=0 x
  for x in "$(items_dir)"/W-*; do
    [ -d "$x" ] || continue
    x="${x##*/W-}"; case "$x" in ''|*[!0-9]*) continue;; esac
    x=$((10#$x))
    [ "$x" -gt "$n" ] && n="$x"
  done
  printf 'W-%03d' $((n + 1))
}

first_live() {
  local d st
  for d in "$(items_dir)"/W-*; do
    [ -d "$d" ] || continue
    st="$(cat "$d/status" 2>/dev/null || echo open)"
    [ "$st" = "done" ] && continue
    echo "${d##*/}"; return 0
  done
  return 1
}

count_active() {
  local d n=0
  for d in "$(items_dir)"/W-*; do
    [ -d "$d" ] || continue
    [ "$(cat "$d/status" 2>/dev/null || echo open)" = active ] && n=$((n+1))
  done
  echo "$n"
}

resolve() {  # $1 = id или пусто → первый не-done
  local id="${1:-}"
  if [ -z "$id" ]; then
    id="$(first_live)" || { echo "devh: нет открытых items (devh new)" >&2; exit 1; }
  fi
  case "$id" in [0-9]*) id="$(printf 'W-%03d' "$((10#$id))")";; esac
  [ -d "$(items_dir)/$id" ] || { echo "devh: нет item $id" >&2; exit 1; }
  echo "$id"
}

item_status() { cat "$(items_dir)/$1/status" 2>/dev/null || echo open; }
set_status()  { # атомарно: tmp + mv в той же ФС
  local f; f="$(items_dir)/$1/status"
  printf '%s\n' "$2" > "$f.tmp" && mv -f "$f.tmp" "$f"
}
branch_of()   { echo "devh/$1"; }
repo_slug() { printf '%s' "$ROOT" | cksum | cut -d' ' -f1; }
wt_of()       { echo "$WT_ROOT/devh-$(repo_slug)-$1"; }

# путь → имя модуля для {module}: gobot/lib/foo/bar.ex → Foo.Bar
mod_of() {
  local p="$1" seg out=""
  p="${p#"$MUTATE_SCOPE"/}"; p="${p#./}"; p="${p%.ex}"
  while [ -n "$p" ]; do
    seg="${p%%/*}"; [ "$seg" = "$p" ] && p="" || p="${p#*/}"
    out="${out}$(printf '%s' "${seg:0:1}" | tr '[:lower:]' '[:upper:]')${seg:1}."
  done
  printf '%s' "${out%.}"
}

# ─── промпт агента ────────────────────────────────────────────────
prompt_for() { # $1=id
  local id="$1" extra=""
  if [ -f "$(items_dir)/$id/red.cmd" ]; then
    extra="${extra}Есть RED-пруф: поведение, которое сейчас падает, после твоих правок обязано проходить.
"
  fi
  if [ -n "$RULES" ]; then
    extra="${extra}Справочник проекта: $ROOT/$RULES — прочитай целиком. Это база известных граблей и уроков (технические знания: как здесь пишется код). Процессные правила уже вшиты в гейты харнесса. В тексте работы и в summary НЕ упоминай этот файл и todo/.
"
  fi
  if [ -n "$MUTATE" ]; then
    extra="${extra}Тесты будут проверены мутационным гейтом: они обязаны УБИВАТЬ мутантов (kill-rate ≥ ${MIN_KILL}%). Пиши точные ассерты на реальное поведение; толерантные/тривиальные тесты гейт не пропустит.
"
  fi
  extra="${extra}ON-FLY ANALYSIS: каждый файл, который открываешь/читаешь/правишь, анализируй ПОПУТНО — ни одно чтение в пустую: неоптимальность, избыточность, мёртвый код, дыра в тестах, подозрительный контракт → это ТИКЕТ (НЕ чинить — вне спеки!). Дописывай строкой в $HDIR/observations.md: <файл>:<строка> | <подозрение> | red-тест: <идея>. Тикет без red-теста не считается.
"
  cat <<EOF
Ты работаешь в изолированном git-worktree: $(wt_of "$id"). Все правки — только здесь.

ЗАДАЧА: реализуй спеку $HDIR/items/$id/spec.md (прочитай её полностью).
Заметки прошлых попыток (если есть): $HDIR/items/$id/plan.md — если не закончишь, допиши туда кратко: что сделано / что дальше.

Контекст репо (HEAD на момент старта задачи):
$(git -C "$ROOT" log --oneline -3 2>/dev/null | sed 's/^/  /')

ЖЕЛЕЗНЫЕ ПРАВИЛА:
1. НИКОГДА не запускай git (add/commit/push/checkout/stash...) — харнесс владеет git.
2. Реализуй спеку целиком: код + тесты, по стандартам проекта.
3. Перед завершением прогони проверку сам: \`$VERIFY\` (из корня worktree). Она обязана проходить.
${extra}4. В конце напиши summary по-русски в файл $HDIR/summaries/$id.md:
   первая строка — готовое описание коммита одним предложением (про изменения в проекте, без упоминания харнесса/спеки),
   дальше — детали и что проверено.
   Если застрял: первая строка 'BLOCKED: <причина>'.

Окружение: HARNESS_WORKTREE, HARNESS_SPEC, HARNESS_PLAN, HARNESS_SUMMARY — абсолютные пути.
EOF
}

prompt_for_red() { # $1=id — фаза RED: агент пишет red-ТЕСТ (его ПЕРВАЯ задача)
  local id="$1"
  cat <<EOF
Ты работаешь в изолированном git-worktree: $(wt_of "$id"). Это ФАЗА RED: твоя ПЕРВАЯ задача — написать RED-ТЕСТ. Саму спеку НЕ реализуй.

ЗАДАЧА: создай файл $HDIR/items/$id/red.cmd — ГОТОВЫЙ К ЗАПУСКУ ТЕСТ, который СЕЙЧАС падает на чистом HEAD и зеленеет после реализации спеки $HDIR/items/$id/spec.md.

Что здесь считается тестом:
- прогон настоящего тестового входа проекта: той же команды/раннера, что у тебя в VERIFY ($VERIFY), только под нужный тест или сюит;
- запускается как \`bash <этот файл>\` из корня worktree: exit 0 = тест прошёл, exit ≠ 0 = тест упал;
- на чистом HEAD тест ОБЯЗАН упасть (exit ≠ 0), иначе гейт RED ответит «уже зелёный»;
- проверяет поведение из спеки и позеленеет ТОЛЬКО после её реализации.

ЗАПРЕЩЕНО вместо теста: grep/rg по файлам, test -f/-e и прочие проверки существования, «найди строку в файле», одиночные вызовы без тестового раннера. Это не тест — гейт RED такому не обязан верить; настоящий RED — упавший тест.

Правила фазы:
- в worktree ничего не пиши: исходники и git не трогай — можно только читать код, чтобы написать осмысленный тест;
- файл ОДИН: $HDIR/items/$id/red.cmd (лежит вне worktree, в .harness);
- summary в этой фазе не нужен — его напишет фаза реализации.

Контекст репо (HEAD на момент старта задачи):
$(git -C "$ROOT" log --oneline -3 2>/dev/null | sed 's/^/  /')
EOF
}

# ─── init ─────────────────────────────────────────────────────────
cmd_init() {
  [ -f "$CONF" ] && { echo "devh: $CONF уже есть (перезапись: rm $CONF)" >&2; exit 1; }
  mkdir -p "$HDIR/items" "$HDIR/summaries" "$HDIR/logs"
  if [ -z "$VERIFY" ]; then
    if   [ -x "$ROOT/scripts/verify.sh" ]; then VERIFY='./scripts/verify.sh'
    elif [ -f "$ROOT/gobot/mix.exs" ];       then VERIFY='cd gobot && mix test'; BOOTSTRAP='cd gobot && mix deps.get && mix compile'
    elif [ -f "$ROOT/mix.exs" ];             then VERIFY='mix test'; BOOTSTRAP='mix deps.get && mix compile'
    elif [ -f "$ROOT/Cargo.toml" ];          then VERIFY='cargo test'; BOOTSTRAP='cargo fetch'
    elif grep -q '^verify:' "$ROOT/Makefile" 2>/dev/null; then VERIFY='make verify'
    fi
  fi
  if [ -f "$ROOT/gobot/mix.exs" ] && [ -z "$MUTATE" ]; then
    MUTATE='cd gobot && mix mutants --module {module}'   # muex; нет muex → env-блокер на run (установи)
    MUTATE_SCOPE='gobot/lib'
  fi
  if [ -f "$ROOT/Cargo.toml" ] && [ -z "$MUTATE" ]; then
    MUTATE='cargo mutants -f {file}'   # cargo-mutants; установи: cargo install cargo-mutants
    MUTATE_SCOPE='src'
  fi
  [ -n "$MUTATE_SCOPE" ] || MUTATE_SCOPE='lib'
  if [ -f "$ROOT/gobot/mix.exs" ] && [ -z "$CRAP" ]; then
    CRAP='cd gobot && mix crap.report'
    CRAP_SCOPE='gobot/lib dev'
  fi
  if [ -f "$ROOT/scripts/crap-rs.sh" ] && [ -z "$CRAP" ]; then
    CRAP='bash scripts/crap-rs.sh'
    CRAP_SCOPE='uwa-core/src crates'
  fi
  if [ -f "$ROOT/todo/report.md" ]; then
    RULES='todo/report.md'; RULES_LOG='todo/report.md'
  fi
  [ -n "$MSG_DENY" ] || MSG_DENY='todo/|report\.md|Session [0-9]+'
  MAIN="$(git -C "$ROOT" branch --show-current 2>/dev/null || true)"
  [ -n "$MAIN" ] || MAIN=main
  cat > "$CONF" <<EOF
# devh config (source-ится bash'ем). Env-переменные HARNESS_* перекрывают.
VERIFY='$VERIFY'            # команда проверки; обязана проходить после работы агента
BOOTSTRAP='$BOOTSTRAP'       # однократная подготовка свежего worktree (deps и т.п.)
AGENT='$AGENT'               # агент; промпт передаётся одним аргументом
AGENT_TIMEOUT=$AGENT_TIMEOUT # сек на один запуск агента (watchdog: «агент сдох»)
MAX_FIX=$MAX_FIX             # раундов «гейт упал → агент чинит»
MAX_ACTIVE=$MAX_ACTIVE       # WIP-лимит: сколько items могут быть active одновременно (0 = выкл)
REMOTE='$REMOTE'             # git remote; репо без remote — пуш пропускается
MAIN='$MAIN'                 # ветка, куда мержим (текущая на момент init)
WT_ROOT='$WT_ROOT'           # где живут worktree'ы
LOG_DAYS=$LOG_DAYS            # retention логов в .harness/logs (0 = не чистить)
# ── гейты качества тестов/кода (пусто = выкл) ──
MUTATE='$MUTATE'  # мутационный гейт; {module}/{file} подставляются на каждый изменённый файл
MUTATE_SCOPE='$MUTATE_SCOPE'  # какие пути считать «прод-кодом» для мутаций
MIN_KILL=$MIN_KILL           # минимальный kill-rate, %
RED_MUTATE='$RED_MUTATE'  # контроль red-теста: шаблон мутантов с {test} (пусто = выкл)
RED_MIN_KILL=$RED_MIN_KILL      # минимальный kill-rate именно red-теста, %
CRAP='$CRAP'  # гейт CRAP (guardrail №2): score = C²·(1−cov)³ + C; пусто = выкл
CRAP_SCOPE='$CRAP_SCOPE'  # какие пути анализировать (пусто = все изменённые)
CRAP_MAX=$CRAP_MAX            # порог нарушения: score > MAX = красный
BENCH=''                     # перф-гейт, пример: bash devharness/examples/check_bench.sh
# ── session-workflow (uwa: todo/report.md) ──
RULES='$RULES'               # файл правил проекта; промпт: «прочитай полностью, исполняй беспрекословно»
RULES_LOG='$RULES_LOG'       # куда дописывать «## Session N …» после merge (пусто = выкл)
MSG_DENY='$MSG_DENY'         # гигиена сообщения коммита (grep -E): матч → reject, лечение: devh commit
NO_IGNORED=$NO_IGNORED          # 1 = allowlist-гейт ignored: незаявленный игнор = fail (0 = выкл для чужих форматов)
IGNORED_ALLOWLIST='$IGNORED_ALLOWLIST'  # файл: regex имён ignored-тестов, которым разрешён игнор (нет файла = пустой)
LINT=$LINT                      # 1 = авто-shellcheck изменённых *.sh
LINT_CMD='$LINT_CMD'         # проектный линтер (напр. cargo clippy -- -D warnings); пусто = выкл
REVIEW=$REVIEW                  # 1 = self-review диффа вторым запросом агенту (VERDICT: OK|ISSUES)
EOF
  # локальный ignore — workflow не попадает в git вообще
  touch "$ROOT/.git/info/exclude"
  grep -qx '.harness/' "$ROOT/.git/info/exclude" || echo '.harness/' >> "$ROOT/.git/info/exclude"
  echo "${C_G}OK init: $CONF${C_0}"
  [ -n "$VERIFY" ] || echo "${C_Y}⚠  VERIFY не задетектирован — пропиши в $CONF${C_0}"
}

# ─── new ───────────────────────────────────────────────────────────
cmd_new() {
  need_conf
  local arg="" no_red="" no_crap=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-red) no_red="${2:?--no-red требует записанную причину}"; shift 2 ;;
      --no-crap) no_crap="${2:?--no-crap требует записанную причину}"; shift 2 ;;
      *) arg="$1"; shift ;;
    esac
  done
  local title id d
  # числовой id = сессия из todo/N.md (workflow uwa)
  if [[ "$arg" =~ ^[0-9]+$ ]] && [ -f "$ROOT/todo/$arg.md" ]; then
    id="$(printf 'W-%03d' "$arg")"; d="$(items_dir)/$id"
    [ -e "$d" ] && { echo "devh: $id уже есть" >&2; exit 1; }
    crit_begin
    mkdir -p "$d" && cp "$ROOT/todo/$arg.md" "$d/spec.md"
    crit_end
    title="$(head -1 "$d/spec.md")"; title="${title#\# }"; [ -n "$title" ] || title="Session $arg"
    echo "$title" > "$d/title"; echo open > "$d/status"; : > "$d/plan.md"
    [ -n "$no_red" ] && echo "$no_red" > "$d/no-red"
    [ -n "$no_crap" ] && echo "$no_crap" > "$d/no-crap"
    echo "${C_G}OK $id: $title (спека из todo/$arg.md)${no_red:+ [RED пропущен: $no_red]}${no_crap:+ [CRAP пропущен: $no_crap]}${C_0}"
    echo "   RED-пруф ОБЯЗАТЕЛЕН (в первую очередь): $d/red.cmd — команда, падающая на чистом HEAD"
    return 0
  fi
  title="${arg:?devh new \"title\"}"
  crit_begin                       # next_id под глобальным локом: параллельные new не склеятся
  id="$(next_id)"; d="$(items_dir)/$id"
  mkdir -p "$d"; echo "$title" > "$d/title"; echo open > "$d/status"; : > "$d/plan.md"
  crit_end
  if [ ! -t 0 ]; then cat > "$d/spec.md"
  else : > "$d/spec.md"; "${EDITOR:-vi}" "$d/spec.md"; fi
  if [ -z "$no_red" ]; then
    local redl
    redl="$(grep -m1 '^RED:' "$d/spec.md" 2>/dev/null | sed 's/^RED: *//;s/[[:space:]]*$//' || true)"
    if [ -n "$redl" ]; then printf '%s\n' "$redl" > "$d/red.cmd"; fi
  fi
  [ -n "$no_red" ] && echo "$no_red" > "$d/no-red"
  [ -n "$no_crap" ] && echo "$no_crap" > "$d/no-crap"
  echo "${C_G}OK $id: $title (спека: $d/spec.md)${no_red:+ [RED пропущен: $no_red]}${no_crap:+ [CRAP пропущен: $no_crap]}${C_0}"
  echo "   RED-пруф ОБЯЗАТЕЛЕН (в первую очередь): $d/red.cmd — команда, падающая на чистом HEAD"
}

# ─── list ──────────────────────────────────────────────────────────
cmd_list() {
  need_conf
  local d id st wt
  printf '%-7s %-8s %-3s %s\n' ID STATUS WT TITLE
  for d in "$(items_dir)"/W-*; do
    [ -d "$d" ] || continue
    id="${d##*/}"; st="$(item_status "$id")"
    case "$st" in
      open)   stc="${C_Y}$st${C_0}" ;;
      active) stc="${C_C}$st${C_0}" ;;
      done)   stc="${C_G}$st${C_0}" ;;
      *)      stc="$st" ;;
    esac
    wt="-"; [ -d "$(wt_of "$id")" ] && wt=yes
    printf '%-7s %-8s %-3s %s\n' "$id" "$stc" "$wt" "$(cat "$d/title" 2>/dev/null)"
  done
  return 0
}

# ─── hint ──────────────────────────────────────────────────────────
cmd_hint() {
  need_conf
  local id; id="$(resolve "${1:-}")"
  echo "# $id — $(cat "$(items_dir)/$id/title")  [$(item_status "$id")]"
  if [ -s "$(items_dir)/$id/plan.md" ]; then echo; echo '## План/заметки:'; cat "$(items_dir)/$id/plan.md"; fi
  echo; echo '## Спека:'; cat "$(items_dir)/$id/spec.md"
  echo; echo '## Контекст для следующей модели:'; prompt_for "$id"
}

# ─── сигнатура раннера: RED-LINK сравнивает red.cmd с VERIFY ────────
runner_sig() { # $1 = команда → «интерпретатор + путь» либо первый исполняемый токен
  local -a toks=()
  local tok exec next i=0
  read -r -a toks <<<"$1" || true
  while [ "$i" -lt "${#toks[@]}" ]; do
    tok="${toks[$i]}"
    case "$tok" in
      if | then | else | elif | fi | do | done | while | until | for | case | 'esac' | 'in' | '!' | '{' | '}' | '(' | ')')
        i=$((i + 1)); continue ;;
      [A-Za-z_]*=*) i=$((i + 1)); continue ;;
    esac
    break
  done
  [ "$i" -lt "${#toks[@]}" ] || return 0
  exec="${toks[$i]}"; exec="${exec#./}"
  [ -n "$exec" ] || return 0
  case "$exec" in
    bash | sh | zsh | dash | ksh | mksh | python | python3 | python2 | node | deno | ruby | perl)
      next="${toks[$((i + 1))]:-}"
      case "$next" in
        '' | -*) printf '%s' "$exec" ;;
        *) printf '%s %s' "$exec" "${next#./}" ;;
      esac ;;
    *) printf '%s' "$exec" ;;
  esac
}
runner_sigs() { # $1 = команда → сигнатуры подкоманд (;, &&, ||, |), по одной на строку
  local cmd="$1" cur="" ch nxt ins=0 ind=0 i=0 n part
  local -a parts=()
  n="${#cmd}"
  while [ "$i" -lt "$n" ]; do
    ch="${cmd:$i:1}"
    if [ "$ins" = 1 ] || [ "$ind" = 1 ]; then
      case "$ch" in
        "'") [ "$ins" = 1 ] && ins=0 || true ;;
        '"') [ "$ind" = 1 ] && ind=0 || true ;;
      esac
      cur="$cur$ch"; i=$((i + 1)); continue
    fi
    case "$ch" in
      "'") ins=1; cur="$cur$ch" ;;
      '"') ind=1; cur="$cur$ch" ;;
      ';') parts+=("$cur"); cur="" ;;
      '|' | '&')
        nxt="${cmd:$((i + 1)):1}"
        if [ "$nxt" = "$ch" ]; then i=$((i + 1)); fi
        parts+=("$cur"); cur="" ;;
      *) cur="$cur$ch" ;;
    esac
    i=$((i + 1))
  done
  parts+=("$cur")
  for part in "${parts[@]}"; do
    part="$(runner_sig "$part")"
    [ -n "$part" ] && printf '%s\n' "$part"
    true
  done
  return 0
}
red_links_ok() { # $1 = red.cmd, $2 = VERIFY → 0, если раннеры совпадают (или VERIFY пуст)
  local vs reds s
  vs="$(runner_sigs "$2")"
  [ -n "$vs" ] || return 0
  reds="$(runner_sigs "$1")"
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    printf '%s\n' "$vs" | grep -qxF -- "$s" && return 0
  done <<<"$reds"
  return 1
}

# ─── mutation-гейт ─────────────────────────────────────────────────
# Вывод инструмента: 'Mutants: N, Killed: M' (muex-формат). Нет вывода → env-блокер (rc=2): среда ≠ работа агента.
mutate_gate() { # $1 = команда, $2 = min_kill, $3 = label, $4 = ключ конфига
  local MUTATE_L="$1" MIN_KILL_L="$2" LABEL="$3" KEY="$4"
  local files f mod out t k pct fail=0
  # shellcheck disable=SC2086  # MUTATE_SCOPE — список pathspec, слово-разбиение намеренно
  files="$(git -C "$wt" diff --name-only HEAD -- $MUTATE_SCOPE 2>/dev/null | sort -u)"
  # shellcheck disable=SC2086  # MUTATE_SCOPE — список pathspec, слово-разбиение намеренно
  if [ -z "$files" ] && [ -n "$(git -C "$wt" status --porcelain -- $MUTATE_SCOPE)" ]; then
    files="$(git -C "$wt" status --porcelain -- $MUTATE_SCOPE 2>/dev/null | cut -c4- | sort -u)"
  fi
  if [[ "$MUTATE_L" != *'{'* ]]; then   # без плейсхолдеров — один прогон на всё
    out="$(cd "$wt" && bash -c "$MUTATE_L" 2>&1)" || true
    if [[ "$out" =~ Mutants:[[:space:]]*([0-9]+),[[:space:]]*Killed:[[:space:]]*([0-9]+) ]]; then
      t="${BASH_REMATCH[1]}"; k="${BASH_REMATCH[2]}"
      if [ "$t" -gt 0 ]; then
        pct=$(( k * 100 / t ))
        echo "$LABEL: Mutants $t, killed $k (${pct}%)"
        [ "$pct" -lt "$MIN_KILL_L" ] && { echo "$LABEL FAIL: kill-rate ${pct}% < ${MIN_KILL_L}%"; return 1; }
      else
        echo "$LABEL: 0 мутантов — нечего убивать, пропуск"
      fi
    else
      echo "$LABEL env: инструмент не распознан (нет 'Mutants: N, Killed: M'); $KEY='$MUTATE_L'"
      return 2
    fi
    return 0
  fi
  [ -n "$files" ] || { echo "$LABEL: нет изменённых файлов в $MUTATE_SCOPE — гейт пропущен"; return 0; }
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ ! -f "$wt/$f" ]; then echo "$LABEL: $f удалён агентом — мутации не требуется"; continue; fi
    mod="$(mod_of "$f")"
    local cmd; cmd="${MUTATE_L//\{module\}/$mod}"; cmd="${cmd//\{file\}/$f}"
    out="$(cd "$wt" && bash -c "$cmd" 2>&1)" || true
    if [[ "$out" =~ Mutants:[[:space:]]*([0-9]+),[[:space:]]*Killed:[[:space:]]*([0-9]+) ]]; then
      t="${BASH_REMATCH[1]}"; k="${BASH_REMATCH[2]}"
      if [ "$t" -gt 0 ]; then
        pct=$(( k * 100 / t ))
        echo "$LABEL $f: Mutants $t, killed $k (${pct}%)"
        if [ "$pct" -lt "$MIN_KILL_L" ]; then
          echo "$LABEL FAIL $f: kill-rate ${pct}% < ${MIN_KILL_L}% — тесты не ловят мутантов"
          fail=1
        fi
      else
        echo "$LABEL $f: 0 мутантов — пропуск"
      fi
    else
      echo "$LABEL env: инструмент не распознан для $f; $KEY='$MUTATE_L'"
      return 2
    fi
  done <<<"$files"
  [ "$fail" = 0 ]
}

# гейт LINT: авто-shellcheck изменённых *.sh + проектный LINT_CMD
lint_gate() { # rc: 0 ok, 1 findings, 2 env-блокер
  local files f bad=0
  files="$( { git -C "$wt" diff --name-only HEAD 2>/dev/null || true; git -C "$wt" status --porcelain 2>/dev/null | cut -c4- || true; } | sort -u )"
  if [ "$LINT" = 1 ]; then
    if ! command -v shellcheck >/dev/null 2>&1 && printf '%s\n' "$files" | grep -q '\.sh$'; then
      echo "lint env: нет shellcheck, а изменены .sh — блокер СРЕДЫ (установи)" >&2; return 2
    fi
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      case "$f" in *.sh) ;; *) continue ;; esac
      [ -f "$wt/$f" ] || continue
      echo "lint: shellcheck $f"
      # shellcheck disable=SC2015
      if ! shellcheck "$wt/$f"; then bad=1; fi
    done <<<"$files"
  fi
  if [ -n "$LINT_CMD" ]; then
    echo "lint: $LINT_CMD"
    if ! (cd "$wt" && bash -c "$LINT_CMD"); then bad=1; fi
  fi
  [ "$bad" = 0 ]
}

# гейт CRAP (guardrail №2): score = C²·(1−cov)³ + C, нарушение = score > CRAP_MAX.
# Контракт инструмента: строки '<file>:<line> <fun> C=<n> cov=<n>' + итог 'CRAP: functions=N'.
# Нет контракта → env-блокер (rc=2): среда ≠ работа агента.
crap_gate() { # rc: 0 ok, 1 violations, 2 env-блокер
  local envmsg files f locfun loc fun rest c cov l d s_x1000 fns bad=0 out existing
  envmsg="crap env: инструмент не распознан (нет 'CRAP: functions=N'); CRAP='$CRAP'"
  # shellcheck disable=SC2086  # CRAP_SCOPE — список pathspec, слово-разбиение намеренно
  files="$(git -C "$wt" diff --name-only HEAD -- $CRAP_SCOPE 2>/dev/null | sort -u)"
  # shellcheck disable=SC2086  # CRAP_SCOPE — список pathspec, слово-разбиение намеренно
  if [ -z "$files" ] && [ -n "$(git -C "$wt" status --porcelain -- $CRAP_SCOPE 2>/dev/null)" ]; then
    files="$(git -C "$wt" status --porcelain -- $CRAP_SCOPE 2>/dev/null | cut -c4- | sort -u)"
  fi
  existing=""
  while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$wt/$f" ] && existing+="$f"$'\n'
  done <<<"$files"
  files="${existing%$'\n'}"
  if [ -z "$files" ]; then
    echo "crap: нет изменённых файлов в $CRAP_SCOPE — гейт пропущен"
    return 0
  fi
  out="$(cd "$wt" && DEVH_CRAP_FILES="$files" bash -c "$CRAP" 2>&1)" || true
  fns="$(printf '%s\n' "$out" | grep -m1 '^CRAP: functions=' | sed 's/^CRAP: functions=//' | tr -dc '0-9')"
  if [ -z "$fns" ]; then echo "$envmsg"; return 2; fi
  printf '%s\n' "$out"
  while IFS= read -r line; do
    case "$line" in *" C="*) ;; *) continue ;; esac
    locfun="${line%% C=*}"
    rest="${line#* C=}"
    c="${rest%% *}"
    case "$rest" in *" cov="*) ;; *) echo "$envmsg"; return 2 ;; esac
    cov="${rest#* cov=}"; cov="${cov%% *}"
    case "$locfun" in *" "*) ;; *) echo "$envmsg"; return 2 ;; esac
    loc="${locfun% *}"; fun="${locfun##* }"
    f="${loc%:*}"; l="${loc##*:}"
    case "$c$cov" in ''|*[!0-9]*) echo "$envmsg"; return 2 ;; esac
    case "$l" in ''|*[!0-9]*) echo "$envmsg"; return 2 ;; esac
    [ -n "$f" ] && [ -n "$fun" ] || { echo "$envmsg"; return 2; }
    c=$((10#$c)); cov=$((10#$cov))
    [ "$cov" -gt 100 ] && cov=100
    d=$((100 - cov))
    s_x1000=$(( (c*c*d*d*d + 999) / 1000 + c*1000 ))
    if [ "$s_x1000" -gt $(( CRAP_MAX * 1000 )) ]; then
      echo "crap VIOLATION: CRAP $f:$l $fun C=$c cov=$cov score=$((s_x1000 / 1000))"
      bad=$((bad+1))
    fi
  done <<<"$out"
  echo "crap: $fns functions, $bad violations (CRAP_MAX=$CRAP_MAX)"
  [ "$bad" = 0 ]
}

# гейт REVIEW: дифф → отдельный запрос той же модели; вердикт
review_gate() { # rc: 0 ok, 1 issues, 2 env-блокер
  local out verdict
  out="$(cd "$wt" && git add -N . >/dev/null 2>&1; git diff HEAD 2>/dev/null | head -400)"
  [ -n "$out" ] || { echo "review: диффа нет — пропуск"; return 0; }
  # shellcheck disable=SC2086  # $AGENT — команда+аргументы агента; слово-разбиение намеренно
  verdict="$( cd "$wt" && HARNESS_WORKTREE="$wt" timeout "$AGENT_TIMEOUT" $AGENT "Ты — независимый ревьюер, отдельный запрос. Ниже дифф сгенерированной работы. Review code for inconsistencies and bugs: логика, edge-cases, контракт спеки, качество тестов. Ответ — РОВНО одна строка: VERDICT: OK  — или —  VERDICT: ISSUES: <кратко, через ;>.

$out" 2>&1 )" || { echo "review: агент-ревьюер упал (API/timeout)" >&2; return 2; }
  printf '%s\n' "$verdict"
  case "$verdict" in
    *"VERDICT: ISSUES"*) return 1 ;;
    *"VERDICT: OK"*) return 0 ;;
    *) echo "review: вердикт не распознан (нужна строка VERDICT: …)" >&2; return 2 ;;
  esac
}

# железное правило №2 (allowlist-семантика): игнор разрешён, если имя теста
# матчится regex из IGNORED_ALLOWLIST; незаявленный ignored = красный.
ignored_allowed() { # $1 = имя теста; allowlist — файл $IGNORED_ALLOWLIST (относительный — от $ROOT)
  local name="$1" pat file
  case "$IGNORED_ALLOWLIST" in /*) file="$IGNORED_ALLOWLIST" ;; *) file="$ROOT/$IGNORED_ALLOWLIST" ;; esac
  [ -f "$file" ] || return 1
  while IFS= read -r pat || [ -n "$pat" ]; do
    pat="${pat%$'\r'}"
    case "$pat" in '' | '#'*) continue ;; esac
    printf '%s\n' "$name" | grep -Eq -- "$pat" && return 0
  done <"$file"
  return 1
}
no_ignored_ok() { # $1 = лог verify
  local name bad=""
  while IFS= read -r name; do
    [ -z "$name" ] && continue
    ignored_allowed "$name" || bad="$bad $name"
  done < <(grep -E '^test .+ \.\.\. ignored' "$1" 2>/dev/null |
    sed -E 's/^test (.+) \.\.\. ignored.*/\1/' | sort -u)
  [ -z "$bad" ]
}

# ─── run ────────────────────────────────────────────────────────────
cmd_run() {
  need_conf
  [ -n "$VERIFY" ] || { echo "devh: VERIFY не задан ($CONF)" >&2; exit 1; }
  [ -n "$MUTATE" ] || { echo "devh: MUTATE-гейт ОБЯЗАТЕЛЕН, «пропуск» запрещён — пропиши MUTATE в $CONF (gobot: cd gobot + mix mutants/muex; rust: cargo-mutants)" >&2; exit 1; }
  local id; id="$(resolve "${1:-}")"
  item_runlock "$id" "run"      # per-item лок: два run на один item невозможны
  local d wt br log sum round=0 msg dels prev_st fresh=1
  d="$(items_dir)/$id"; wt="$(wt_of "$id")"; br="$(branch_of "$id")"
  echo $$ > "$d/run.pid"; RUN_PIDFILE="$d/run.pid"; trap 'rm -f "$RUN_PIDFILE"' EXIT
  log="$HDIR/logs/$id-verify.log"; sum="$HDIR/summaries/$id.md"
  # per-item маршрутизация агента (лёгкое — дешёвой модели, сложное — сильной)
  if [ -s "$d/agent" ]; then AGENT="$(cat "$d/agent")"; echo ".. агент (per-item): $AGENT"; fi
  local mlog="$HDIR/logs/$id-mutate.log" rdmlog="$HDIR/logs/$id-redmut.log" blog="$HDIR/logs/$id-bench.log" llog="$HDIR/logs/$id-lint.log" rlog="$HDIR/logs/$id-review.log" craplog="$HDIR/logs/$id-crap.log" which=VERIFY

  # claim: WIP-лимит + статус под глобальным локом
  local t0; t0="$(date +%s)"
  local TIMES="$HDIR/logs/$id-timing.log" tprev
  : > "$TIMES"; tprev="$t0"
  tstage() { local n; n="$(date +%s)"; printf '%s %s\n' "$1" "$((n - tprev))" >> "$TIMES"; tprev="$n"; }
  crit_begin
  prev_st="$(item_status "$id")"
  if [ "$MAX_ACTIVE" -gt 0 ] && [ "$prev_st" != active ]; then
    local na; na="$(count_active)"
    if [ "$na" -ge "$MAX_ACTIVE" ]; then
      crit_end
      echo "devh: WIP-лимит — уже $na active (MAX_ACTIVE=$MAX_ACTIVE). Заверши их (devh merge / abort) прежде чем брать новое." >&2
      exit 1
    fi
  fi
  [ "$prev_st" != active ] && set_status "$id" active
  crit_end
  [ "$prev_st" = active ] && echo "${C_G}OK resume: $id уже active — продолжаем${C_0}"

  run_agent() { # $1 = промпт; $2 = стадия тайминга (опц.); timeout = watchdog «агент сдох»
    # shellcheck disable=SC2086  # $AGENT — команда+аргументы агента; слово-разбиение намеренно
    ( cd "$wt" && env HARNESS_WORKTREE="$wt" HARNESS_SPEC="$d/spec.md" \
        HARNESS_PLAN="$d/plan.md" HARNESS_SUMMARY="$sum" HARNESS_VERIFY="$VERIFY" \
        timeout "$AGENT_TIMEOUT" $AGENT "$1" ) > "$HDIR/logs/$id-agent.log" 2>&1 \
      || { echo "${C_R}FAIL агент (код выше; timeout=${AGENT_TIMEOUT}s; лог: $HDIR/logs/$id-agent.log)${C_0}" >&2; set_status "$id" active; exit 1; }
    tstage "${2:-agent-r$((round+1))}"
  }

  # 1. worktree (+ однократный bootstrap)
  if [ ! -d "$wt" ]; then
    if git -C "$ROOT" show-ref -q --verify "refs/heads/$br"; then
      git -C "$ROOT" worktree add "$wt" "$br" >/dev/null
    else
      git -C "$ROOT" worktree add -b "$br" "$wt" HEAD >/dev/null
    fi
    echo "${C_G}OK worktree: $wt (ветка $br)${C_0}"
    if [ -n "$BOOTSTRAP" ]; then
      echo ".. bootstrap: $BOOTSTRAP"
      (cd "$wt" && bash -c "$BOOTSTRAP") > "$HDIR/logs/$id-bootstrap.log" 2>&1 \
        || { echo "${C_R}FAIL bootstrap (лог: $HDIR/logs/$id-bootstrap.log)${C_0}" >&2; exit 1; }
    fi
  else
    echo "${C_G}OK resume worktree: $wt${C_0}"
    fresh=0
  fi
  tstage "worktree(+bootstrap)"

  # 2. RED-пруф — В ПЕРВУЮ ОЧЕРЕДЬ: обязательный гейт
  if [ -s "$d/no-red" ]; then
    echo "${C_Y}⚠  RED пропущен (записанный обход): $(cat "$d/no-red")${C_0}"
  else
    local red_attempt=0 red_max=$(( MAX_FIX > 0 ? MAX_FIX : 1 )) red_prompt red_sigs red_cmd
    while :; do
      red_attempt=$((red_attempt + 1))
      if [ ! -f "$d/red.cmd" ]; then
        if [ "$red_attempt" = 1 ]; then
          echo "${C_Y}.. red: red.cmd отсутствует — поручаю агенту написать его первой задачей${C_0}"
        else
          echo "${C_Y}.. red: раннер red.cmd не совпадает с раннером VERIFY — поручаю переписать (попытка $red_attempt/$red_max)${C_0}"
        fi
        red_prompt="$(prompt_for_red "$id")"
        if [ "$red_attempt" -gt 1 ]; then
          red_cmd="$(cat "$d/red.cmd" 2>/dev/null || true)"
          red_sigs="$(runner_sigs "$red_cmd")"
          red_prompt="$red_prompt

КОРРЕКЦИЯ: red.cmd обязан запускать тот же раннер/бинарь, что и VERIFY ($VERIFY), а сейчас там: ${red_sigs:-<нет файла>}. Перепиши файл строго этим раннером.
"
        fi
        run_agent "$red_prompt" red-author
        if [ ! -f "$d/red.cmd" ]; then
          if [ "$red_attempt" -ge "$red_max" ]; then
            echo "${C_R}FAIL: RED-пруф ОБЯЗАТЕЛЕН (в первую очередь). Агент не написал $d/red.cmd — команду, падающую на чистом HEAD и зеленеющую после работы; либо записанный обход: echo \"<причина>\" > $d/no-red${C_0}" >&2
            exit 1
          fi
          continue
        fi
      fi
      red_cmd="$(cat "$d/red.cmd" 2>/dev/null || true)"
      red_links_ok "$red_cmd" "$VERIFY" && break
      if [ "$red_attempt" -ge "$red_max" ]; then
        echo "${C_R}FAIL: RED-LINK: раннер red.cmd ($(runner_sigs "$red_cmd" | tr '\n' '|')) не совпадает с раннером VERIFY ($(runner_sigs "$VERIFY" | tr '\n' '|')) — red обязан гонять тот же тестовый вход${C_0}" >&2
        echo "      поправь $d/red.cmd (или строку RED: в спеке, либо выровняй VERIFY) и повтори: devh run $id${C_0}"
        set_status "$id" active; exit 1
      fi
      rm -f "$d/red.cmd"
    done
    if [ "$fresh" = 0 ] && [ -n "$(git -C "$wt" status --porcelain)" ]; then
      echo "${C_G}OK resume: RED pre-check пропущен — дерево уже содержит работу; доказательство RED было на чистом HEAD первой попытки, позеленение проверит пост-гейт${C_0}"
    elif (cd "$wt" && bash "$d/red.cmd") >/dev/null 2>&1; then
      echo "${C_R}FAIL: red.cmd уже зелёный на чистом HEAD — это не баг. Почини red.cmd или удали.${C_0}" >&2
      exit 1
    else
      echo "${C_G}OK red: падает на HEAD (пруф воспроизводится)${C_0}"
    fi
  fi
  tstage "red-pre"

  if [ -s "$d/no-crap" ] && [ -n "$CRAP" ]; then
    echo "${C_Y}⚠  CRAP пропущен (записанный обход): $(cat "$d/no-crap")${C_0}"
  fi

  # 3. агент → гейт-цикл (verify → lint → crap → review → mutation → bench; падение → fix-раунд агенту)
  gate() {
    local mrc lrc rrc crc
    if ! (cd "$wt" && bash -c "$VERIFY") > "$log" 2>&1; then which=VERIFY; return 1; fi
    tstage "verify-r$((round+1))"
    if [ "$NO_IGNORED" = 1 ] && ! no_ignored_ok "$log"; then which=NO-IGNORED; return 1; fi
    lint_gate > "$llog" 2>&1
    lrc=$?
    tstage "lint-r$((round+1))"
    if [ "$lrc" -eq 2 ]; then
      cat "$llog" >&2; echo "FAIL: lint env-блокер. Блокер СРЕДЫ, не работа агента (детали выше)." >&2
      set_status "$id" active; exit 1
    fi
    if [ "$lrc" -ne 0 ]; then which=LINT; return 1; fi
    if [ -n "$CRAP" ] && [ ! -s "$d/no-crap" ]; then
      crap_gate > "$craplog" 2>&1
      crc=$?
      tstage "crap-r$((round+1))"
      if [ "$crc" -eq 2 ]; then
        cat "$craplog" >&2; echo "FAIL: CRAP env-блокер. Блокер СРЕДЫ, не работа агента (детали выше)." >&2
        set_status "$id" active; exit 1
      fi
      if [ "$crc" -ne 0 ]; then which=CRAP; return 1; fi
    fi
    if [ "$REVIEW" = 1 ]; then
      review_gate > "$rlog" 2>&1
      rrc=$?
      tstage "review-r$((round+1))"
      if [ "$rrc" -eq 2 ]; then
        cat "$rlog" >&2; echo "FAIL: review env-блокер (агент-ревьюер упал/вердикт не распознан). Блокер СРЕДЫ." >&2
        set_status "$id" active; exit 1
      fi
      if [ "$rrc" -ne 0 ]; then which=REVIEW; return 1; fi
    fi
    if [ -n "$MUTATE" ]; then
      mutate_gate "$MUTATE" "$MIN_KILL" mutation MUTATE > "$mlog" 2>&1
      mrc=$?
      tstage "mutate-r$((round+1))"
      if [ "$mrc" -eq 2 ]; then
        echo "${C_R}FAIL: mutation env-блокер — инструмент не распознан. Блокер СРЕДЫ, не работа агента: установи (gobot: muex; rust: cargo-mutants) или исправь MUTATE в $CONF. Детали: $mlog${C_0}" >&2
        set_status "$id" active; exit 1
      fi
      if [ "$mrc" -ne 0 ]; then which=MUTATE; return 1; fi
    fi
    if [ -n "$BENCH" ]; then
      if ! (cd "$wt" && bash -c "$BENCH") > "$blog" 2>&1; then which=BENCH; return 1; fi
      tstage "bench-r$((round+1))"
    fi
    return 0
  }
  echo ".. агент: $AGENT"
  run_agent "$(prompt_for "$id")"
  while ! gate; do
    round=$((round+1))
    if [ "$round" -gt "$MAX_FIX" ]; then
      echo "${C_R}FAIL: гейт $which красный после $MAX_FIX раундов фикса (логи: $HDIR/logs/$id-*.log)${C_0}" >&2
      set_status "$id" active; exit 1
    fi
    echo ".. гейт $which упал — раунд фикса $round/$MAX_FIX"
    case "$which" in
      VERIFY) run_agent "Verify не прошёл. Хвост лога:

$(tail -40 "$log")

Почини по логу. Правила те же: git не трогать, после фикса сам прогони: \`$VERIFY\`. Обнови summary: $sum" ;;
      LINT) run_agent "Линтер нашёл проблемы в изменённых файлах. Хвост лога:

$(tail -30 "$llog")

Почини так, чтобы линтер был чист (стиль — по замечаниям линтера, не глуши его). git не трогай. Обнови summary: $sum" ;;
      CRAP) run_agent "CRAP-гейт не прошёл: сложность функций хуже порога (score = C²·(1−cov)³ + C, нарушение = score > $CRAP_MAX). Лог:

$(tail -40 "$craplog")

Снизь сложность изменённых функций (разбей длинные цепочки условий, убери дублирование) или покрой их тестами (coverage ↑). Ослаблять/удалять проверки и «чинить» порог запрещено. git не трогай. Обнови summary: $sum" ;;
      REVIEW) run_agent "Независимый ревьюер нашёл замечания (второй запрос той же модели):

$(tail -5 "$rlog")

Почини эти проблемы в рамках спеки, не расширяя скоуп. git не трогай. Обнови summary: $sum" ;;
      NO-IGNORED) run_agent "Verify прошёл, но в выводе есть НЕзаявленные ignored-тесты. Правило (allowlist): игнор разрешён только для имён из $IGNORED_ALLOWLIST; незаявленный ignored = скрытый красный. Хвост лога:\n\n$(grep -E '^test .+ \.\.\. ignored' "$log" | head -10)\n\nРазбери причину игнора: почини тест и включи его; удаление проверки или новый ignore без причины запрещены (легальный долг — запись в allowlist). git не трогай. Обнови summary: $sum" ;;
      MUTATE) run_agent "Mutation-гейт не прошёл: твои тесты НЕ УБИВАЮТ мутантов на изменённом коде (kill-rate < ${MIN_KILL}%). Лог:

$(tail -40 "$mlog")

УСИЛЬ тесты изменённых модулей: точные ассерты на реальное поведение, граничные случаи, никаких ослаблений ассертов и удаления проверок. Ослабить тест, чтобы «позеленело», запрещено. git не трогай. Обнови summary: $sum" ;;
      BENCH) run_agent "Bench-гейт не прошёл (перф-регрессия против baseline). Лог:

$(tail -40 "$blog")

Разберись с производительностью изменённого кода (алгоритм, а не микромагия). git не трогай. Обнови summary: $sum" ;;
    esac
  done
  echo "${C_G}OK гейты: verify${MUTATE:+ +mutation}${BENCH:+ +bench}${C_0}"

  # 4. RED-пруф: после работы обязан проходить
  if [ -f "$d/red.cmd" ] && [ ! -s "$d/no-red" ]; then
    (cd "$wt" && bash "$d/red.cmd") >/dev/null 2>&1 \
      || { echo "${C_R}FAIL: red.cmd не позеленел — фикс не доказан${C_0}" >&2; set_status "$id" active; exit 1; }
    echo "${C_G}OK red: позеленел${C_0}"
  fi
  tstage "red-post"

  # 4.1 RED-MUT: red-тест обязан убивать мутантов (RED_MUTATE, {test} = red.cmd)
  if [ -n "$RED_MUTATE" ] && [ -f "$d/red.cmd" ] && [ ! -s "$d/no-red" ]; then
    case "$RED_MUTATE" in
      *'{test}'*) ;;
      *)
        echo "${C_R}FAIL: RED-MUT: в RED_MUTATE нет шаблона {test} — нечем подставить команду red ($d/red.cmd)${C_0}" >&2
        echo "      пример: RED_MUTATE=\"bash scripts/mutate.sh '{test}'\" — прогон мутантов, которые ловятся только red-тестом; и повтори: devh run $id${C_0}"
        set_status "$id" active; exit 1 ;;
    esac
    red_cmd="$(cat "$d/red.cmd")"
    local rrc=0
    mutate_gate "${RED_MUTATE//\{test\}/$red_cmd}" "$RED_MIN_KILL" red-mutation RED_MUTATE > "$rdmlog" 2>&1 || rrc=$?
    tstage "redmut"
    if [ "$rrc" = 2 ]; then
      echo "${C_R}FAIL: RED-MUT env-блокер — инструмент не распознан (лог: $rdmlog)${C_0}" >&2
      set_status "$id" active; exit 1
    fi
    if [ "$rrc" != 0 ]; then
      echo "${C_R}FAIL: RED-MUT: red-тест убивает слишком мало мутантов — он не доказывает, что проверяет изменение${C_0}" >&2
      echo "      усили $d/red.cmd (или удали его — агент напишет заново); лог: $rdmlog${C_0}"
      set_status "$id" active; exit 1
    fi
    echo "${C_G}OK red-mutation: red-тест ловит мутантов в изменённых файлах${C_0}"
  fi

  # 5. summary / BLOCKED
  if [ ! -s "$sum" ]; then echo "${C_R}FAIL: агент не написал summary ($sum)${C_0}" >&2; set_status "$id" active; exit 1; fi
  if head -1 "$sum" | grep -q '^BLOCKED'; then
    head -1 "$sum"; set_status "$id" active; exit 1
  fi

  # 6. commit — только харнесс; гейты гигиены
  msg="$(head -1 "$sum" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | cut -c1-72)"
  [ -n "$msg" ] || msg="$id: $(cut -c1-60 "$d/title")"
  if [ -n "$MSG_DENY" ] && printf '%s\n' "$msg" | grep -qiE "$MSG_DENY"; then
    echo "${C_R}FAIL: сообщение коммита нарушает гигиену ($MSG_DENY): «$msg»${C_0}" >&2
    echo "      поправь ПЕРВУЮ строку $sum (без упоминаний workflow) и: devh commit $id" >&2
    set_status "$id" active; exit 1
  fi
  if ( cd "$wt" && git add -A && git diff --cached --quiet ); then
    echo "${C_R}FAIL: агент не оставил изменений${C_0}" >&2; set_status "$id" active; exit 1
  fi
  echo "— staged:"; git -C "$wt" diff --cached --stat | tail -5
  dels="$(git -C "$wt" diff --cached --diff-filter=D --name-only | wc -l)"
  if [ "$dels" -gt 5 ]; then echo "${C_Y}⚠  удалений в коммите: $dels — проверь, что это задумано${C_0}"; fi
  git -C "$wt" commit -q -m "$msg"
  echo "${C_G}OK commit: $msg${C_0}"
  printf 'fix-rounds=%d gates=verify%s%s duration=%ds\n' \
    "$round" "${MUTATE:+,mutation}" "${BENCH:+,bench}" "$(( $(date +%s) - t0 ))" > "$d/last-run"
  printf 'timing: %s\n' "$(awk '{printf "%s=%ss ", $1, $2}' "$TIMES")" >> "$d/last-run"

  # 7. push ветки (ревью перед main — двухфазный merge)
  if has_remote; then
    if (cd "$wt" && git push -q -u "$REMOTE" "$br"); then echo "${C_G}OK push: $REMOTE/$br${C_0}"
    else echo "${C_Y}⚠  push не прошёл — коммит локальный; продолжай: devh merge $id${C_0}"; fi
  fi
  tstage "commit+push"
  echo
  echo "${C_C}— тайминг стадий (сек):${C_0}"
  awk -v D="$C_D" -v Z="$C_0" '{printf "%s  %-24s %ss%s\n", D, $1, $2, Z}' "$TIMES"
  set_status "$id" active
  echo
  echo "${C_B}ГОТОВО: $id на ветке $br.${C_0} Ревью: git -C $wt diff $MAIN..$br — затем: ${C_B}devh merge $id${C_0}"
}

# ─── commit (повтор commit/push по готовой работе) ─────────────────
cmd_commit() {
  need_conf
  local id; id="$(resolve "${1:-}")"
  [ "$(item_status "$id")" = active ] || { echo "devh: $id не в active" >&2; exit 1; }
  item_runlock "$id" "commit"
  local d wt br sum msg
  d="$(items_dir)/$id"; wt="$(wt_of "$id")"; br="$(branch_of "$id")"; sum="$HDIR/summaries/$id.md"
  [ -d "$wt" ] || { echo "devh: нет worktree $wt (сначала devh run $id)" >&2; exit 1; }
  [ -s "$sum" ] || { echo "${C_R}FAIL: нет summary ($sum)${C_0}" >&2; exit 1; }
  head -1 "$sum" | grep -q '^BLOCKED' && { head -1 "$sum"; exit 1; }
  msg="$(head -1 "$sum" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | cut -c1-72)"
  [ -n "$msg" ] || msg="$id: $(cut -c1-60 "$d/title")"
  if [ -n "$MSG_DENY" ] && printf '%s\n' "$msg" | grep -qiE "$MSG_DENY"; then
    echo "${C_R}FAIL: сообщение всё ещё нарушает гигиену: «$msg» — правь $sum${C_0}" >&2; exit 1
  fi
  if [ -n "$(git -C "$wt" status --porcelain)" ]; then
    git -C "$wt" add -A
    if git -C "$wt" diff --cached --quiet; then echo "${C_R}FAIL: изменений нет${C_0}" >&2; exit 1; fi
    git -C "$wt" commit -q -m "$msg"
    echo "${C_G}OK commit: $msg${C_0}"
  else
    echo "${C_G}OK: изменений нет — только push${C_0}"
  fi
  if has_remote; then
    (cd "$wt" && git push -q -u "$REMOTE" "$br") && echo "${C_G}OK push: $REMOTE/$br${C_0}" \
      || echo "${C_Y}⚠  push не прошёл — потом: devh merge $id${C_0}"
  fi
  echo "далее: devh merge $id"
}

# ─── merge ─────────────────────────────────────────────────────────
cmd_merge() {
  need_conf
  local id; id="$(resolve "${1:-}")"
  [ "$(item_status "$id")" = active ] || { echo "devh: $id не в active (нет закрытой работы)" >&2; exit 1; }
  item_runlock "$id" "merge"    # не мержить, пока run жив
  local wt br sum; wt="$(wt_of "$id")"; br="$(branch_of "$id")"; sum="$HDIR/summaries/$id.md"
  [ -d "$wt" ] || { echo "devh: нет worktree $wt (сначала devh run $id)" >&2; exit 1; }

  # гейты: worktree чист и на ветке есть коммиты сверх MAIN
  if [ -n "$(git -C "$wt" status --porcelain)" ]; then
    echo "${C_R}FAIL: в worktree незакоммиченные изменения — разберись в $wt (или devh abort $id)${C_0}" >&2; exit 1
  fi
  if [ "$(git -C "$wt" rev-list --count "$MAIN..HEAD")" -eq 0 ] 2>/dev/null; then
    echo "${C_R}FAIL: на $br нет коммитов сверх $MAIN — работы нет (devh abort $id?)${C_0}" >&2; exit 1
  fi

  local upstream="$MAIN"
  if has_remote; then git -C "$ROOT" fetch -q "$REMOTE" "$MAIN"; upstream="$REMOTE/$MAIN"; fi
  echo ".. rebase $br на $upstream"
  git -C "$wt" rebase "$upstream" \
    || { echo "${C_R}FAIL rebase — разреши конфликты в $wt, затем: git -C $wt rebase --continue && devh merge $id${C_0}" >&2; exit 1; }
  local sha; sha="$(git -C "$wt" rev-parse --short HEAD)"

  if has_remote; then
    git -C "$wt" push -q "$REMOTE" "HEAD:$MAIN" && echo "${C_G}OK push $REMOTE/$MAIN ($sha)${C_0}" \
      || { echo "${C_R}FAIL push в $MAIN — разреши руками из $wt${C_0}" >&2; exit 1; }
    git -C "$wt" push -q "$REMOTE" --delete "$br" 2>/dev/null || true
    git -C "$ROOT" fetch -q . "$br:$MAIN" 2>/dev/null \
      || git -C "$ROOT" merge -q --ff-only "$br" 2>/dev/null \
      || echo "${C_Y}⚠  локальный $MAIN не обновлён (грязное дерево/не ff) — подтяни руками${C_0}"
  else
    git -C "$ROOT" merge -q --ff-only "$br" && echo "${C_G}OK локальный ff в $MAIN ($sha)${C_0}" \
      || { echo "${C_R}FAIL: $MAIN не ff — разреши руками: git merge --ff-only $br${C_0}" >&2; exit 1; }
  fi

  { echo "## $id — $(cat "$(items_dir)/$id/title") ($(date +%F))"
    echo "- commit: $sha"
    [ -s "$(items_dir)/$id/last-run" ] && echo "- run: $(cat "$(items_dir)/$id/last-run")"
    sed -n '2,$p' "$sum" 2>/dev/null | sed 's/^/  /'
    echo
  } >> "$HDIR/log.md"
  if [ -n "$RULES_LOG" ] && [ -f "$ROOT/$RULES_LOG" ]; then
    { echo; echo "## Session $((10#${id#W-})) — $(cat "$(items_dir)/$id/title") ($(date +%F))"
      echo "- commit: $sha"
      sed -n '2,$p' "$sum" 2>/dev/null | sed 's/^/  /'
    } >> "$ROOT/$RULES_LOG"
    echo "report: сессия дописана в $RULES_LOG"
  fi
  git -C "$ROOT" worktree remove --force "$wt" 2>/dev/null || true
  git -C "$ROOT" branch -D "$br" >/dev/null 2>&1 || true
  set_status "$id" "done"
  echo "${C_G}OK $id → done. Лог: .harness/log.md${C_0}"
  local nx; nx="$(first_live)" && echo "${C_B}next: $nx — $(cat "$(items_dir)/$nx/title" 2>/dev/null)${C_0}" || echo "${C_B}next: очередь пуста 🎉${C_0}"
}

# ─── bg / ps: detached-прогоны ───────────────────────────────────────
cmd_bg() { # run в фоне: setsid (свой session, immune to HUP) + nohup
  need_conf
  local id; id="$(resolve "${1:-}")"
  local bglog="$HDIR/logs/$id-bg.log"
  setsid nohup "$0" run "$id" >>"$bglog" 2>&1 </dev/null &
  echo "${C_G}OK bg${C_0}: $id → ${C_B}PID $!${C_0}; лог: $bglog"
  echo "   следить: ${C_B}devh ps${C_0} | tail -f $bglog | по завершении: devh merge $id"
}

cmd_ps() { # кто в полёте: PID, elapsed, текущая стадия из timing.log
  need_conf
  local d id pid el stage found=0
  for d in "$(items_dir)"/W-*; do
    [ -f "$d/run.pid" ] || continue
    id="${d##*/}"; pid="$(cat "$d/run.pid" 2>/dev/null || true)"; found=$((found+1))
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      el=$(( $(date +%s) - $(stat -c %Y "$d/run.pid") ))
      stage="$(tail -1 "$HDIR/logs/$id-timing.log" 2>/dev/null | awk '{print $1}')"
      printf '%-7s PID %-8s %5ss   стадия: %s\n' "$id" "$pid" "$el" "${stage:-старт}"
    else
      echo "${C_Y}$id: pid-файл есть, процесс мёртв (обрыв?) — статус: $(item_status "$id")${C_0}"
    fi
  done
  [ "$found" = 0 ] && echo "нет прогонов в полёте"
  return 0
}

# ─── tickets: OnFlyAnalysis-наблюдения агентов → items ────────────────
cmd_tickets() { # без аргумента — показать; --import — превратить в items
  need_conf
  local obs="$HDIR/observations.md"
  if [ "${1:-}" != "--import" ]; then
    if [ -s "$obs" ]; then cat "$obs"; else echo "нет наблюдений ($obs) — агенты пишут сюда по ходу работы"; fi
    return 0
  fi
  [ -s "$obs" ] || { echo "нет наблюдений"; return 0; }
  local line n=0 skipped=0 title idea id d
  crit_begin
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    if ! printf '%s\n' "$line" | grep -q 'red-тест:'; then
      echo "  пропущено (нет red-идеи): $line"; skipped=$((skipped+1)); continue
    fi
    title="$(printf '%s' "$line" | awk -F'|' 'NF>=2 {gsub(/^ +| +$/,"",$1); gsub(/^ +| +$/,"",$2); printf "obs: %s — %s", $1, $2}' | cut -c1-72)"
    idea="$(printf '%s' "$line" | sed -n 's/.*red-тест: *//p' | cut -c1-200)"
    id="$(next_id)"; d="$(items_dir)/$id"; mkdir -p "$d"
    echo "$title" > "$d/title"; echo open > "$d/status"; : > "$d/plan.md"
    { echo "Тикет из OnFlyAnalysis (наблюдение агента по ходу чужой спеки):"
      echo "$line"
      echo
      echo "RED-тест ОБЯЗАТЕЛЕН при взятии в работу: $idea"
      echo
      echo "Уточни по месту наблюдения: что чинить и чем доказывать. Не чини смежное — только предмет тикета."
    } > "$d/spec.md"
    echo "  + $id: $title"
    n=$((n+1))
  done < "$obs"
  crit_end
  : > "$obs"
  echo "${C_G}OK tickets${C_0}: $n импортировано (red-идея в спеке каждого), пропущено: $skipped"
}

# ─── auto: автопилот — папка спек → items → run → merge → tickets ─────
cmd_auto() { # devh auto [--from <dir>] [--max N]: всё само, пока есть очередь
  need_conf
  local from="" max=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from="${2:?--from требует каталог спек}"; shift 2 ;;
      --max)  max="${2:?--max требует число}"; shift 2 ;;
      *) echo "неизвестный аргумент: $1" >&2; exit 1 ;;
    esac
  done
  export HARNESS_MAX_ACTIVE=0   # auto сериален — WIP-лимит избыточен
  local imp=0 f title id d redl
  if [ -n "$from" ]; then
    for f in "$from"/*.md; do
      [ -f "$f" ] || continue
      title="$(head -1 "$f")"; title="${title#\# }"
      [ -n "$title" ] || title="$(basename "${f%.md}")"
      crit_begin
      id="$(next_id)"; d="$(items_dir)/$id"; mkdir -p "$d"
      crit_end
      cp "$f" "$d/spec.md"
      echo "$title" > "$d/title"; echo open > "$d/status"; : > "$d/plan.md"
      redl="$(grep -m1 '^RED: ' "$f" 2>/dev/null | sed 's/^RED: *//' || true)"
      [ -n "$redl" ] && echo "$redl" > "$d/red.cmd"
      echo "  импорт: $id — $title${redl:+ (RED ✓)}"
      imp=$((imp+1))
    done
    echo "auto: импортировано $imp спек из $from"
  fi
  local tried=" " done_n=0 fail_n=0 item rc
  pick_next() { # $1=tried; первый не-done вне tried
    local d st id
    for d in "$(items_dir)"/W-*; do
      [ -d "$d" ] || continue
      id="${d##*/}"
      case "$1" in *" $id "*) continue ;; esac
      st="$(cat "$d/status" 2>/dev/null || echo open)"
      [ "$st" = "done" ] && continue
      echo "$id"; return 0
    done
    return 1
  }
  while item="$(pick_next "$tried")"; do
    tried="$tried$item "
    echo "── auto: $item — $(cat "$(items_dir)/$item/title" 2>/dev/null)"
    if [ ! -f "$(items_dir)/$item/red.cmd" ] && [ ! -s "$(items_dir)/$item/no-red" ]; then
      echo "   .. RED-пруфа нет — его напишет агент (первая задача)"
    fi
    if "$0" run "$item" >/dev/null 2>&1; then
      if "$0" merge "$item" >/dev/null 2>&1; then
        echo "   ${C_G}✓ done${C_0}"; done_n=$((done_n+1))
      else
        echo "   ⚠  run ок, merge отклонил — ревью руками"; fail_n=$((fail_n+1))
      fi
    else
      rc=$?
      echo "   ${C_R}✗ rc=$rc${C_0} — остаётся active; детали: devh logs $item"
      fail_n=$((fail_n+1))
    fi
    "$0" tickets --import >/dev/null 2>&1 || true
    if [ "$max" -gt 0 ] && [ $((done_n + fail_n)) -ge "$max" ]; then break; fi
  done
  echo "auto: конец — done=$done_n, не прошло=$fail_n"
  local d st
  for d in "$(items_dir)"/W-*; do
    [ -d "$d" ] || continue
    st="$(cat "$d/status" 2>/dev/null || echo open)"
    [ "$st" = "done" ] && continue
    echo "  остался: ${d##*/} ($st) — $(cat "$d/title" 2>/dev/null)"
  done
  return 0
}

# ─── selfcov: line-coverage devh — BASH_ENV + DEBUG trap, без внешних инструментов ──
cmd_selfcov() {
  local dh; dh="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
  SELF_COV_W="$(mktemp -d /tmp/devh-selfcov-XXXXXX)"
  trap 'rm -rf "$SELF_COV_W"' EXIT
  cat > "$SELF_COV_W/preamble.sh" <<'S'
set -o functrace   # DEBUG-ловушка наследуется функциями и под-оболочками
trap 'case "${BASH_SOURCE[0]}" in */devh-classic) printf "%s:%s\n" "${BASH_SOURCE[0]}" "$LINENO" >> "${COV_OUT:?}" ;; esac' DEBUG
S
  : > "$SELF_COV_W/cov.txt"
  echo "прогон suite с трассировкой строк devh (~40с, DEBUG-trap добавляет накладные)…"
  DEVH="$dh/devh-classic" BASH_ENV="$SELF_COV_W/preamble.sh" COV_OUT="$SELF_COV_W/cov.txt" bash "$dh/test.sh" >/dev/null 2>&1 || {
    echo "❌ базовый suite красный — покрытие бессмысленно"; return 1; }
  local covered total pct
  covered="$(awk -F: '/(^|\/)devh-classic:/ && $NF+0>0 {print $NF}' "$SELF_COV_W/cov.txt" | sort -n | uniq | wc -l)"
  total="$(grep -cvE '^[[:space:]]*(#|$)' "$dh/devh-classic")"
  pct="$(awk -v c="$covered" -v t="$total" 'BEGIN{printf "%.0f%%", (t>0? c*100/t : 0)}')"
  echo "${C_G}coverage devh: $covered/$total исполняемых строк (${pct})${C_0}"
  echo "  (под-оболочки \$(…) не трассируются — число слегка занижено; HTML-подробности не нужны)"
  echo "${C_C}непокрытые исполняемые строки (первые 25):${C_0}"
  awk 'NR==FNR { if ($0 ~ /devh-classic:/) { n=split($0, a, ":"); if (a[n]+0>0) cov[a[n]+0]=1 } next }
       { if (!(FNR in cov) && $0 !~ /^[[:space:]]*(#|$)/) printf "  %d: %s\n", FNR, $0 }' \
       "$SELF_COV_W/cov.txt" "$dh/devh-classic" | head -25
  echo "  полный список: $SELF_COV_W/cov.txt (каталог удалится с сессией — сохрани при необходимости)"
  return 0
}


# ─── logs (наблюдаемость) ───────────────────────────────────────────
cmd_logs() {
  need_conf
  local id l
  if [ -n "${1:-}" ]; then
    id="$(resolve "$1")"
    echo "# логи $id — $HDIR/logs/:"
    find "$HDIR/logs" -maxdepth 1 -name "$id-*.log" -printf '%f (%s байт)\n' 2>/dev/null | sort | sed 's/^/  /'
    echo
    echo "живой прогон можно смотреть: tail -f $HDIR/logs/$id-agent.log"
    if [ -f "$HDIR/logs/$id-agent.log" ]; then
      echo; echo "— хвост agent.log:"; tail -15 "$HDIR/logs/$id-agent.log"
    fi
    if [ -f "$HDIR/logs/$id-verify.log" ]; then
      echo; echo "— хвост verify.log:"; tail -10 "$HDIR/logs/$id-verify.log"
    fi
  else
    echo "# все логи ($HDIR/logs/, свежие сверху):"
    local l
    l="$(find "$HDIR/logs" -maxdepth 1 -name '*.log' -printf '%TY-%Tm-%Td %TH:%TM %f (%s байт)\n' 2>/dev/null | sort -r | head -15)"
    if [ -n "$l" ]; then printf '%s\n' "$l" | sed 's/^/  /'; else echo "  (пусто)"; fi
  fi
}

# ─── abort / clean / doctor ────────────────────────────────────────
cmd_abort() {
  need_conf
  local id; id="$(resolve "${1:-}")"
  item_runlock "$id" "abort"    # не выбрасывать worktree из-под живого run
  local wt br; wt="$(wt_of "$id")"; br="$(branch_of "$id")"
  rm -f "$(items_dir)/$id/run.pid" 2>/dev/null || true
  if [ -d "$wt" ]; then git -C "$ROOT" worktree remove --force "$wt"; echo "${C_G}OK worktree убран${C_0}"; fi
  git -C "$ROOT" branch -D "$br" >/dev/null 2>&1 || true
  if has_remote; then git -C "$ROOT" push -q "$REMOTE" --delete "$br" 2>/dev/null || true; fi
  set_status "$id" open
  echo "${C_G}OK $id → open (работа выброшена)${C_0}"
}

cmd_clean() {
  need_conf
  local d id st wt br n=0
  for d in "$(items_dir)"/W-*; do
    [ -d "$d" ] || continue
    id="${d##*/}"; st="$(item_status "$id")"; wt="$(wt_of "$id")"; br="$(branch_of "$id")"
    if [ "$st" = "done" ] && { [ -d "$wt" ] || git -C "$ROOT" show-ref -q --verify "refs/heads/$br"; }; then
      rm -f "$d/run.pid" 2>/dev/null || true
      git -C "$ROOT" worktree remove --force "$wt" 2>/dev/null || true
      git -C "$ROOT" branch -D "$br" >/dev/null 2>&1 || true
      n=$((n+1)); echo "clean: $id"
    fi
  done
  if [ "$LOG_DAYS" -gt 0 ] 2>/dev/null; then
    find "$HDIR/logs" -type f -mtime +"$LOG_DAYS" -delete 2>/dev/null && echo "retention: логи старше ${LOG_DAYS}д убраны"
  fi
  echo "${C_G}OK clean ($n)${C_0}"
}

cmd_doctor() {
  need_conf
  local fail=0 warn=0 ag="${AGENT%% *}" d id st wt
  say() {
  case "$1" in
    ok*)   echo "${C_G}$1${C_0}" ;;
    FAIL*) echo "${C_R}$1${C_0}" ;;
    WARN*) echo "${C_Y}$1${C_0}" ;;
    *)     echo "$1" ;;
  esac
}
  command -v git >/dev/null 2>&1 && say "ok   git $(git --version | cut -d' ' -f3)" || { say "FAIL нет git"; fail=1; }
  [ -n "$VERIFY" ] && say "ok   VERIFY: $VERIFY" || { say "FAIL VERIFY не задан"; fail=1; }
  command -v "$ag" >/dev/null 2>&1 && say "ok   агент: $ag" || { say "WARN агент '$ag' не найден в PATH"; warn=1; }
  has_flock && say "ok   flock (блокировки состояний)" || { say "WARN нет flock — состояние без блокировок"; warn=1; }
  command -v timeout >/dev/null 2>&1 && say "ok   timeout (watchdog)" || { say "WARN нет coreutils timeout"; warn=1; }
  command -v shellcheck >/dev/null 2>&1 && say "ok   shellcheck (статический слой)" || { say "WARN нет shellcheck — статика пропускается"; warn=1; }
  if has_remote; then
    git -C "$ROOT" ls-remote -q "$REMOTE" HEAD >/dev/null 2>&1 && say "ok   remote $REMOTE" || { say "WARN remote $REMOTE недоступен"; warn=1; }
  else
    say "ok   репо без remote (локальный режим)"
  fi
  grep -qx '.harness/' "$ROOT/.git/info/exclude" 2>/dev/null && say "ok   .harness/ в exclude" || { say "WARN .harness/ не в .git/info/exclude"; warn=1; }
  if [ -n "$MUTATE" ]; then
    local mbin="${MUTATE##*&& }"; mbin="${mbin%% *}"
    command -v "$mbin" >/dev/null 2>&1 && say "ok   mutation: $mbin доступен ($MUTATE_SCOPE)" || { say "WARN mutation: '$mbin' не найден — run будет заблокирован (установи инструмент)"; warn=1; }
  else
    say "ok   mutation-гейт выключен"
  fi
  [ -n "$BENCH" ] && say "ok   bench-гейт: $BENCH" || say "ok   bench-гейт выключен"
  if [ -n "$CRAP" ]; then
    local cout
    if command -v timeout >/dev/null 2>&1; then
      cout="$(cd "$ROOT" && DEVH_CRAP_FILES='' timeout 120 bash -c "$CRAP" 2>&1)" || true
    else
      cout="$(cd "$ROOT" && DEVH_CRAP_FILES='' bash -c "$CRAP" 2>&1)" || true
    fi
    if printf '%s\n' "$cout" | grep -q '^CRAP: functions='; then
      say "ok   CRAP: инструмент отвечает (контракт распознан)"
    else
      say "FAIL CRAP: инструмент не отвечает по контракту (нет 'CRAP: functions=N') — блокер СРЕДЫ"
      fail=1
    fi
  else
    say "ok   CRAP-гейт не настроен"
  fi
  # crash-recovery: сироты после прерванных run
  for d in "$(items_dir)"/W-*; do
    [ -d "$d" ] || continue
    id="${d##*/}"; st="$(item_status "$id")"; wt="$(wt_of "$id")"
    if [ "$st" = active ] && [ ! -d "$wt" ]; then
      say "WARN $id active без worktree (прерванный run?) — devh run $id продолжит или devh abort $id"; warn=1
    fi
    if [ "$st" = open ] && [ -d "$wt" ]; then
      say "WARN $id: worktree есть, статус open — devh run $id продолжит с места обрыва"; warn=1
    fi
  done
  [ "$(count_active)" -gt 0 ] && say "ok   active items: $(count_active) (WIP-лимит $MAX_ACTIVE)" || say "ok   очередей в работе нет"
  echo "doctor: fail=$fail warn=$warn"
  [ "$fail" -eq 0 ]
}

# ─── dispatch ──────────────────────────────────────────────────────
case "${1:-help}" in
  init)  shift; cmd_init "$@" ;;
  new)   shift; cmd_new "$@" ;;
  list|status) shift; cmd_list "$@" ;;
  hint)  shift; cmd_hint "$@" ;;
  run)   shift; cmd_run "$@" ;;
  commit) shift; cmd_commit "$@" ;;
  merge) shift; cmd_merge "$@" ;;
  abort) shift; cmd_abort "$@" ;;
  clean) shift; cmd_clean "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  bg) shift; cmd_bg "$@" ;;
  ps) shift; cmd_ps "$@" ;;
  tickets) shift; cmd_tickets "$@" ;;
  auto) shift; cmd_auto "$@" ;;
  selfcov) shift; cmd_selfcov "$@" ;;
  *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
